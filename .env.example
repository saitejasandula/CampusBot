# ==========================================
# CampusBot Backend Configuration (Render)
# ==========================================

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# LLM model name for generation
MODEL_NAME=gemini-1.5-flash

# Embedding provider: "gemini" (recommended for Render 512MB RAM free tier) or "local" (sentence-transformers)
EMBEDDING_PROVIDER=gemini

# Embedding model: "models/text-embedding-004" (for Gemini) or "all-MiniLM-L6-v2" (for local)
EMBEDDING_MODEL=models/text-embedding-004

# Cosine similarity threshold (0.0 to 1.0) to filter irrelevant queries
SIMILARITY_THRESHOLD=0.45

# Admin key for POST /ingest endpoint authorization
ADMIN_KEY=campusbot-admin-secret

# CORS Allowed Origins (comma-separated or "*" for public access from Vercel)
ALLOWED_ORIGINS=*

# ==========================================
# CampusBot Frontend Configuration (Vercel)
# ==========================================

# URL pointing to the deployed backend on Render (or http://localhost:8000 for local dev)
VITE_API_URL=https://campusbot-backend.onrender.com
